*TRANS:FOREX3*,,411550
C     C5 - COUNTERS: /TRACE/ AFTER THREE PLOT CALLS
      PROGRAM C5CNTR
      COMMON /TRACE/ NEXC50, NEXC70, NEXC72, NEXC74, NPLOT
      CALL PAGE()
      CALL MOVE(10.0,10.0)
      CALL PLOT()
      CALL MOVE(20.0,10.0)
      CALL PLOT()
      CALL MOVE(20.0,20.0)
      CALL PLOT()
      CALL ENDPG()
      PRINT 900, NEXC50, NEXC70, NEXC72, NEXC74, NPLOT
  900 FORMAT(' NITI-C5 NEXC50-74 NPLOT',5I8)
      END
*execute
*end file
