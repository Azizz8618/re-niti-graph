*TRANS:FOREX3*,,411550
C     C4 - PAGE: TWO PAGES WITH PAGE / ENDPG BOUNDARIES
      PROGRAM C4PAGE
      COMMON /TRACE/ NEXC50, NEXC70, NEXC72, NEXC74, NPLOT
      CALL PAGE()
      CALL MOVE(10.0,10.0)
      CALL PLOT()
      CALL ENDPG()
      CALL PAGE()
      CALL MOVE(50.0,50.0)
      CALL PLOT()
      CALL ENDPG()
      PRINT 900, NPLOT
  900 FORMAT(' NITI-C4 NPLOT=',I6)
      END
*execute
*end file
