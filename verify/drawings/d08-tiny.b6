*TRANS:FOREX3*,,411550
C     C1 - STRAIGHT LINE: MOVE / PLOT BETWEEN TWO ENDPOINTS
      PROGRAM C1LINE
      COMMON /TRACE/ NEXC50, NEXC70, NEXC72, NEXC74, NPLOT
      CALL PAGE()
      CALL MOVE(5.0,5.0)
      CALL PLOT()
      CALL MOVE(12.0,12.0)
      CALL PLOT()
      CALL ENDPG()
      PRINT 900, NPLOT
  900 FORMAT(' NITI-C1 NPLOT=',I6)
      END
