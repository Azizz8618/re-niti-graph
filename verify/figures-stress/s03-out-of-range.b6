*TRANS:FOREX3*,,411550
C     S03 - NEGATIVE CONTROL: ONE FRAME WITH X=6000 IS REJECTED
C     THREE VALID POINTS, ONE OUT OF RANGE, THEN ONE MORE VALID POINT
      PROGRAM S3OOR
      COMMON /TRACE/ NEXC50, NEXC70, NEXC72, NEXC74, NPLOT
      CALL PAGE()
      CALL MOVE(100.0,100.0)
      CALL PLOT()
      CALL MOVE(200.0,200.0)
      CALL PLOT()
      CALL MOVE(300.0,300.0)
      CALL PLOT()
      CALL MOVE(6000.0,400.0)
      CALL PLOT()
      CALL MOVE(400.0,500.0)
      CALL PLOT()
      CALL ENDPG()
      PRINT 900, NPLOT
  900 FORMAT(' NITI-STRESS NPLOT=',I6)
      END
*execute
*end file
