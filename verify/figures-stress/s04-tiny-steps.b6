C     S04 - TINY STEPS: 18 FRAMES, DELTAS OF 1-2, TWO REPEATED POINTS
      PROGRAM S4TINY
      COMMON /TRACE/ NEXC50, NEXC70, NEXC72, NEXC74, NPLOT
      CALL PAGE()
      CALL MOVE(100.0,100.0)
      CALL PLOT()
      CALL MOVE(101.0,100.0)
      CALL PLOT()
      CALL MOVE(101.0,101.0)
      CALL PLOT()
      CALL MOVE(103.0,101.0)
      CALL PLOT()
      CALL MOVE(103.0,102.0)
      CALL PLOT()
      CALL MOVE(105.0,102.0)
      CALL PLOT()
      CALL MOVE(105.0,103.0)
      CALL PLOT()
      CALL MOVE(105.0,103.0)
      CALL PLOT()
      CALL MOVE(106.0,103.0)
      CALL PLOT()
      CALL MOVE(106.0,105.0)
      CALL PLOT()
      CALL MOVE(108.0,105.0)
      CALL PLOT()
      CALL MOVE(108.0,106.0)
      CALL PLOT()
      CALL MOVE(108.0,106.0)
      CALL PLOT()
      CALL MOVE(109.0,106.0)
      CALL PLOT()
      CALL MOVE(109.0,107.0)
      CALL PLOT()
      CALL MOVE(111.0,107.0)
      CALL PLOT()
      CALL MOVE(111.0,108.0)
      CALL PLOT()
      CALL MOVE(112.0,108.0)
      CALL PLOT()
      CALL ENDPG()
      PRINT 900, NPLOT
  900 FORMAT(' NITI-STRESS NPLOT=',I6)
      END
