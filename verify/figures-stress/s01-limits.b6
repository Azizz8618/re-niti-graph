*TRANS:FOREX3*,,411550
C     S01 - COORD LIMITS: TOUCH X=5000 AND Y=7500, RETURN TO ORIGIN
      PROGRAM S1LIM
      COMMON /TRACE/ NEXC50, NEXC70, NEXC72, NEXC74, NPLOT
      CALL PAGE()
      CALL MOVE(0.0,0.0)
      CALL PLOT()
      CALL MOVE(5000.0,0.0)
      CALL PLOT()
      CALL MOVE(5000.0,7500.0)
      CALL PLOT()
      CALL MOVE(0.0,7500.0)
      CALL PLOT()
      CALL MOVE(0.0,0.0)
      CALL PLOT()
      CALL ENDPG()
      PRINT 900, NPLOT
  900 FORMAT(' NITI-STRESS NPLOT=',I6)
      END
*execute
*end file
