C     C2 - CIRCLE: ARCIA SWEEP AND CIRCLE POLYGON
      PROGRAM C2CIRC
      COMMON /TRACE/ NEXC50, NEXC70, NEXC72, NEXC74, NPLOT
      COMMON /GFBFTR/ GFBFTR(2)
      GFBFTR(1) = 50.0
      GFBFTR(2) = 0.0
      CALL PAGE()
      CALL ARCIA(100.0,100.0,0.0,0.5235988,12)
      CALL CIRCLE(100.0,100.0,50.0,50.0,12)
      CALL ENDPG()
      PRINT 900, NPLOT
  900 FORMAT(' NITI-C2 NPLOT=',I6)
      END
*execute
*end file
