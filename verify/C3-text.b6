*TRANS:FOREX3*,,411550
C     C3 - TEXT: SYMBOL GLYPHS AND NUMBER LABEL
      PROGRAM C3TEXT
      COMMON /TRACE/ NEXC50, NEXC70, NEXC72, NEXC74, NPLOT
      EXTERNAL SYMBOL
      CALL PAGE()
      CALL SYMBOL(10.0,20.0,1,1)
      CALL SYMBOL(12.0,20.0,2,2)
      CALL NUMBER(20.0,20.0,123.0)
      CALL ENDPG()
      PRINT 900, NPLOT
  900 FORMAT(' NITI-C3 NPLOT=',I6)
      END
*execute
*end file
