C     COMPDT - compare a two-word packed key with the DATA* field.
      SUBROUTINE COMPDT(K1, K2, IFLG)
      INTEGER K1, K2, IFLG, A, B
      INTEGER MASK2
      COMMON /DATAC/ DATAC(2)
C [I] Octal masks 740000000000 and 60740000207400 (COMPDT.mad:38-39)
C     exceed the FOREX integer range; a reduced field mask is used.
      DATA MASK2 /524287/
      IFLG = 1
      A = SHIFT(K1, 8)
      IF (A .EQ. 0) THEN
         DATAC(1) = K1
         DATAC(2) = K2
         IFLG = 0
         RETURN
      END IF
      B = IEOR(IAND(A, MASK2), IAND(DATAC(1), MASK2))
      B = SHIFT(B, -11)
      B = IEOR(B, DATAC(2))
      IF (B .EQ. 0) IFLG = 0
      RETURN
      END
