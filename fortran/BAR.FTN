C     BAR - draw a hatched bar/rectangle with TMF and MOVE.
      SUBROUTINE BAR(X0, Y0, X1, Y1, NH)
      REAL X0, Y0, X1, Y1
      INTEGER NH
      REAL X, Y, DX, DY, T
      INTEGER I, N
      CALL PLOT()
      CALL PLOT()
      CALL PLOT()
      CALL PLOT()
      CALL PLOT()
      N = NH
      IF (N .LT. 0) N = 0
      IF (N .GT. 100) N = 100
      DX = X1 - X0
      DY = Y1 - Y0
      DO 20 I = 1, N
         T = FLOAT(I)/FLOAT(N+1)
         X = X0 + T*DX
         Y = Y0 + T*DY
         CALL PLOT()
         CALL PLOT()
   20 CONTINUE
      RETURN
      ENTRY MOVE(U, V)
      REAL U, V
      CALL PLOT()
      RETURN
      ENTRY IRDB(K, V)
      INTEGER K
      REAL V
      V = FLOAT(K)
      RETURN
      ENTRY RSTI(U, K, R)
      REAL U, R
      INTEGER K
      R = U*FLOAT(K)
      RETURN
      END
