C     BAR - draw a hatched bar/rectangle with TMF and MOVE.
      SUBROUTINE BAR(X0, Y0, X1, Y1, NH)
      REAL Q0
      REAL Q1
      INTEGER Q2
      REAL Q3
      REAL Q4
      INTEGER Q5
      REAL Q6
      REAL X0, Y0, X1, Y1
      INTEGER NH
      REAL X, Y, DX, DY, T
      INTEGER I, N
      REAL U, V
      INTEGER K
      REAL R
      CALL PLOT()
      CALL PLOT()
      CALL PLOT()
      CALL PLOT()
      CALL PLOT()
      N = NH
      IF (N .LT. 0) N = 0
      IF (N .GT. 100) N = 100
      DX = X1 - X0
      DY = Y1 - Y0
      DO 20 I = 1, N
         T = FLOAT(I)/FLOAT(N+1)
         X = X0 + T*DX
         Y = Y0 + T*DY
         CALL PLOT()
         CALL PLOT()
   20 CONTINUE
      RETURN
      ENTRY MOVE(Q0, Q1)
      CALL PLOT()
      RETURN
      ENTRY IRDB(Q2, Q3)
      Q3 = FLOAT(Q2)
      RETURN
      ENTRY RSTI(Q4, Q5, Q6)
      Q6 = Q4*FLOAT(Q5)
      RETURN
      END
