C     RDACC - circular-arc record reader (variant C): three angle
C     points derived from *GFGEL* centre, radii and angles.
      SUBROUTINE RDACC(MODE, OUT)
      REAL Q0
      INTEGER Q1
      REAL Q2
      REAL Q3
      INTEGER Q4
      REAL Q5
      REAL Q6
      REAL Q7
      REAL Q8
      REAL Q9
      REAL Q10
      REAL MODE, OUT(9)
      COMMON /GFGEL/ GFGEL(28)
      REAL R, SA, CA, X0, Y0, A1, A2, A3
      REAL A
      INTEGER K
      REAL X
      REAL C
      REAL S
      X0 = GFGEL(1)
      Y0 = GFGEL(2)
      R = GFGEL(9)
      IF (R .LT. 0.0) R = -R
      A1 = GFGEL(7)
      A2 = GFGEL(3)
      A3 = GFGEL(8)
      CALL RDACG(A1, SA, CA)
      OUT(1) = X0 + R*CA
      OUT(2) = Y0 + R*SA
      CALL RDACG(A2, SA, CA)
      OUT(3) = X0 + R*CA
      OUT(4) = Y0 + R*SA
      CALL RDACG(A3, SA, CA)
      OUT(5) = X0 + R*CA
      OUT(6) = Y0 + R*SA
      OUT(7) = R
      OUT(8) = A1
      OUT(9) = A3 - A1
      RETURN
      ENTRY RSTI(Q0, Q1, Q2)
      Q2 = Q0*FLOAT(Q1)
      RETURN
      ENTRY RDII(Q3, Q4, Q5)
      Q5 = Q3/FLOAT(Q4)
      RETURN
      ENTRY ABS(Q6)
      IF (Q6 .LT. 0.0) Q6 = -Q6
      RETURN
      ENTRY SIN(Q7, Q8)
      CALL RDACG(Q7, Q8, C)
      RETURN
      ENTRY COS(Q9, Q10)
      CALL RDACG(Q9, S, Q10)
      RETURN
      END
      SUBROUTINE RDACG(A, S, C)
      REAL A, S, C
      S = SIN(A)
      C = COS(A)
      RETURN
      END
