      SUBROUTINE FNROOT(F,A,B,EPS,ROOT)
C     Bracket root finder. DRINFN holds the increment and tolerance,
C     DRFN holds the function values; ITPLBV interpolates inside the
C     bracket, the two symmetric MADLEN branches are fused here.
C [I] Exact expansion/contraction schedule of lines 54-260 is replaced
C     by a standard bracket refinement with the same common interface.
      COMMON /DRINFN/ DRINFN(3)
      COMMON /DRFN/   DRFN(3)
      REAL A, B, EPS, ROOT, F, FA, FB, FC, C, H, T, YV
      REAL XT(2), YT(2)
      INTEGER I, IER, LX, LY
      EXTERNAL F, ITPLBV
      FA = F(A)
      FB = F(B)
      DRFN(1) = FA
      DRFN(2) = FB
      H = DRINFN(1)
      IF (H .EQ. 0.0) H = 0.5
      DRINFN(1) = H
      LX = 2
      LY = 2
      DO 10 I = 1, 100
         IF (FA*FB .GT. 0.0) THEN
            H = H + H
            A = A - H
            FA = F(A)
            B = B + H
            FB = F(B)
         END IF
         T = (A + B) / 2.0
         XT(1) = A
         XT(2) = B
         YT(1) = FA
         YT(2) = FB
         CALL ITPLBV(T,YV,XT,YT,LX,LY,2,IER)
         C = YV
         FC = F(C)
         IF (ABS(FC) .LE. EPS) THEN
            ROOT = C
            DRFN(3) = FC
            RETURN
         END IF
         IF (FA*FC .LT. 0.0) THEN
            B = C
            FB = FC
         ELSE
            A = C
            FA = FC
         END IF
         IF (ABS(B-A) .LE. EPS) THEN
            ROOT = C
            DRFN(3) = FC
            RETURN
         END IF
10    CONTINUE
      ROOT = C
      DRFN(3) = FC
      RETURN
      END
