C     CIRTAL - arc generator variant with an extra *GFGEL* field.
C     Uses the third element field (GAM/3) in the coordinate formula.
      SUBROUTINE CIRTAL(XC, YC, A, B, G, A0, A1, N, X, Y)
      REAL Q0
      INTEGER Q1
      REAL Q2
      REAL Q3
      REAL Q4
      REAL Q5
      REAL Q6
      REAL Q7
      REAL Q8
      REAL Q9
      REAL Q10
      REAL Q11
      REAL Q12
      REAL Q13
      REAL XC, YC, A, B, G, A0, A1, X(1000), Y(1000)
      INTEGER N
      REAL T, S, C, D, DA
      INTEGER I
      COMMON /GFVP/ GFVP(6)
      REAL U, R
      INTEGER K
      REAL V
      IF (N .LE. 0) RETURN
      DA = (A1 - A0)/FLOAT(N)
      T = A0
      DO 20 I = 1, N
         CALL CITL(T, S, C)
         D = A*A*S*S + B*B*C*C
         IF (D .LE. 0.0) D = 1.0
         D = G/D
         X(I) = XC + D*A*C
         Y(I) = YC + D*B*S
         IF (X(I) .LT. GFVP(1) .OR. X(I) .GT. GFVP(2)) GO TO 10
         IF (Y(I) .LT. GFVP(3) .OR. Y(I) .GT. GFVP(4)) GO TO 10
         CALL PLOT()
   10    T = T + DA
   20 CONTINUE
      RETURN
      ENTRY RSTI(Q0, Q1, Q2)
      Q2 = Q0*FLOAT(Q1)
      RETURN
      ENTRY ABS(Q3)
      IF (Q3 .LT. 0.0) Q3 = -Q3
      RETURN
      ENTRY SQRT(Q4)
      IF (Q4 .GT. 0.0) Q4 = Q4**0.5
      RETURN
      ENTRY ATAN(Q5, Q6)
      Q6 = ATAN2(Q5, 1.0)
      RETURN
      ENTRY SIGN(Q7, Q8, Q9)
      Q9 = Q7
      IF (Q8 .LT. 0.0) Q9 = -Q9
      RETURN
      ENTRY SIN(Q10, Q11)
      CALL CITL(Q10, Q11, C)
      RETURN
      ENTRY COS(Q12, Q13)
      CALL CITL(Q12, S, Q13)
      RETURN
      END
      SUBROUTINE CITL(A, S, C)
      REAL A, S, C
      S = SIN(A)
      C = COS(A)
      RETURN
      END
