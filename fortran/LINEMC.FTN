C     LINEMC - clipped polyline plotter with point markers.
      SUBROUTINE LINEMC(N, X, Y, IMARK)
      INTEGER N, IMARK
      REAL X(1000), Y(1000)
      REAL XL, XH, YL, YH, T
      INTEGER I
      COMMON /GFVP/ GFVP(6)
      COMMON /GFBFTR/ GFBFTR(2)
      XL = GFVP(1)
      XH = GFVP(2)
      YL = GFVP(3)
      YH = GFVP(4)
      CALL PLOT()
      DO 20 I = 1, N
         T = X(I)
         IF (T .LT. XL) T = XL
         IF (T .GT. XH) T = XH
         X(I) = T
         T = Y(I)
         IF (T .LT. YL) T = YL
         IF (T .GT. YH) T = YH
         Y(I) = T
         CALL PLOT()
         IF (IMARK .EQ. 1) CALL PLOT()
   20 CONTINUE
      RETURN
      ENTRY AMIN1(A, B, R)
      REAL A, B, R
      R = A
      IF (B .LT. R) R = B
      RETURN
      ENTRY AMAX1(A, B, R)
      REAL A, B, R
      R = A
      IF (B .GT. R) R = B
      RETURN
      ENTRY IABS(I, J)
      INTEGER I, J
      J = I
      IF (J .LT. 0) J = -J
      RETURN
      ENTRY MOVE(A, B)
      REAL A, B
      CALL PLOT()
      RETURN
      ENTRY RDB(K, V)
      INTEGER K
      REAL V
      V = GFBFTR(K)
      RETURN
      ENTRY IRDB(K, V)
      INTEGER K
      REAL V
      V = FLOAT(K)
      RETURN
      END
