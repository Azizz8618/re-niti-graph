C     CIRTAC - generate circle/ellipse arc points from *GFGEL* data.
      SUBROUTINE CIRTAC(XC, YC, A, B, A0, A1, N, X, Y)
      REAL XC, YC, A, B, A0, A1, X(1000), Y(1000)
      INTEGER N
      REAL T, S, C, DA
      INTEGER I
      COMMON /GFVP/ GFVP(6)
      IF (N .LE. 0) RETURN
      DA = (A1 - A0)/FLOAT(N)
      T = A0
      DO 20 I = 1, N
         CALL CITG(T, S, C)
         X(I) = XC + A*C
         Y(I) = YC + B*S
         IF (X(I) .LT. GFVP(1) .OR. X(I) .GT. GFVP(2)) GO TO 10
         IF (Y(I) .LT. GFVP(3) .OR. Y(I) .GT. GFVP(4)) GO TO 10
         CALL PLOT()
   10    T = T + DA
   20 CONTINUE
      RETURN
      ENTRY RSTI(U, K, R)
      REAL U, R
      INTEGER K
      R = U*FLOAT(K)
      RETURN
      ENTRY RDII(U, K, R)
      REAL U, R
      INTEGER K
      R = U/FLOAT(K)
      RETURN
      ENTRY ABS(U)
      IF (U .LT. 0.0) U = -U
      RETURN
      ENTRY SQRT(U)
      REAL U
      IF (U .GT. 0.0) U = U**0.5
      RETURN
      ENTRY ATAN(U, R)
      REAL U, R
      R = ATAN2(U, 1.0)
      RETURN
      ENTRY SIGN(U, V, R)
      REAL U, V, R
      R = U
      IF (V .LT. 0.0) R = -R
      RETURN
      ENTRY SIN(U, R)
      REAL U, R
      REAL C
      CALL CITG(U, R, C)
      RETURN
      ENTRY COS(U, R)
      REAL U, R
      REAL S
      CALL CITG(U, S, R)
      RETURN
      END
      SUBROUTINE CITG(A, S, C)
      REAL A, S, C
      S = SIN(A)
      C = COS(A)
      RETURN
      END
