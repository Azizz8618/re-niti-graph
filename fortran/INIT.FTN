C     INIT - initialise the GRAFOR matrix area.
C     HCUNIT is a MADLEN SUBP, converted to an ENTRY.
      SUBROUTINE INIT
      COMMON /GFMATR/ GFMATR(34)
      INTEGER I
      DO 10 I = 1, 34
         GFMATR(I) = 0
   10 CONTINUE
      GFMATR(17) = 1
      RETURN
C     HCUNIT - install a unit row in the matrix area [I].
      ENTRY HCUNIT
      GFMATR(33) = 1
      GFMATR(34) = 1
      RETURN
      END
