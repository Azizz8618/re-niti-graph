C     INIT - initialise the GRAFOR matrix area.
C [I] INIT.mad declares HCUNIT as a SUBP entry, but a separate
C     HCUNIT module exists in the library (HCUNIT.FTN of another
C     batch), so the entry name is not redefined here. The short
C     matrix-row update is inlined instead.
      SUBROUTINE INIT
      COMMON /GFMATR/ GFMATR(34)
      INTEGER I
      DO 10 I = 1, 34
         GFMATR(I) = 0
   10 CONTINUE
      GFMATR(17) = 1
      GFMATR(33) = 1
      GFMATR(34) = 1
      RETURN
      END
