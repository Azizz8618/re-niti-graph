C     SHIFT - affine translation helper (MADLEN module SHIFT).
C [I] The library's two public names from this module are already
C     defined elsewhere: FUNCTION SHIFT(A,N) in SUPPORT.FTN (the
C     ASN/ASX bit-shift helper) and SUBROUTINE ATRAN2 in ATRAN2.FTN
C     (the full affine matrix composition). Defining either name
C     again here would be a duplicate global symbol, so the local
C     translation operation is exposed under the private name SHFT.
      SUBROUTINE SHFT(DX,DY)
      REAL DX,DY
      COMMON /GFATRN/ GFATRN(7)
      GFATRN(1) = 1.0
      GFATRN(2) = DX
      GFATRN(3) = DY
      RETURN
      END
