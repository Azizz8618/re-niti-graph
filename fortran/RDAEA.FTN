C     RDAEA - read/draw a GFGEL ellipse-arc record, variant A.
C [I] Ellipse geometry uses the same SQRT(sin^2+cos^2) form as the
C     original; STRMOD/GFFALS mark element start and failure.
      SUBROUTINE RDAEA(N)
      INTEGER N
      COMMON /GFGEL/ GFGEL(28)
      EXTERNAL STRMOD,GFFALS
      REAL A,B,T,R,X,Y
      IF (GFGEL(9) .LT. 0) THEN
         CALL STRMOD(0)
         RETURN
      END IF
      A = ABS(GFGEL(4))
      B = ABS(GFGEL(5))
      T = GFGEL(7)
      R = SQRT((SIN(T)*A)**2+(COS(T)*B)**2)
      X = GFGEL(4) + R*COS(T)
      Y = GFGEL(5) + R*SIN(T)
      GFGEL(1) = X
      GFGEL(2) = Y
      GFGEL(3) = R
      IF (R .EQ. 0.0) CALL GFFALS(6)
      CALL STRMOD(0)
      RETURN
      END
