C     LICON - intersection of a straight line with a conic from *GFGEL*.
      SUBROUTINE LICON(X0, Y0, X1, Y1, XC, YC, A, B,
     *                 XA, YA, XB, YB, NPT)
      REAL Q0
      REAL Q1
      REAL Q2
      REAL Q3
      REAL Q4
      REAL Q5
      REAL Q6
      REAL Q7
      REAL X0, Y0, X1, Y1, XC, YC, A, B, XA, YA, XB, YB
      INTEGER NPT
      REAL DX, DY, QA, QB, QC, DIS, T1, T2, D
      COMMON /GFGEL/ GFGEL(28)
      REAL U, R
      REAL C
      REAL S
      NPT = 0
      DX = X1 - X0
      DY = Y1 - Y0
      IF (A .EQ. 0.0 .OR. B .EQ. 0.0) RETURN
      QA = DX*DX/(A*A) + DY*DY/(B*B)
      QB = 2.0*((X0-XC)*DX/(A*A) + (Y0-YC)*DY/(B*B))
      QC = (X0-XC)**2/(A*A) + (Y0-YC)**2/(B*B) - 1.0
      DIS = QB*QB - 4.0*QA*QC
      IF (DIS .LT. 0.0) RETURN
      D = DIS**0.5
      T1 = (-QB + D)/(2.0*QA)
      T2 = (-QB - D)/(2.0*QA)
      XA = X0 + T1*DX
      YA = Y0 + T1*DY
      XB = X0 + T2*DX
      YB = Y0 + T2*DY
      NPT = 2
      IF (D .EQ. 0.0) NPT = 1
      RETURN
      ENTRY ATAN(Q0, Q1)
      Q1 = ATAN2(Q0, 1.0)
      RETURN
      ENTRY SQRT(Q2)
      IF (Q2 .GT. 0.0) Q2 = Q2**0.5
      RETURN
      ENTRY ABS(Q3)
      IF (Q3 .LT. 0.0) Q3 = -Q3
      RETURN
      ENTRY SIN(Q4, Q5)
      CALL LICTG(Q4, Q5, C)
      RETURN
      ENTRY COS(Q6, Q7)
      CALL LICTG(Q6, S, Q7)
      RETURN
      END
      SUBROUTINE LICTG(A, S, C)
      REAL A, S, C
      S = SIN(A)
      C = COS(A)
      RETURN
      END
