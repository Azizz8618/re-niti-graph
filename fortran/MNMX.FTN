C     MNMX - min/max scan and viewport scaling (MADLEN MNMX).
C     Finds X/Y extrema, calls MAP and LIMITS and stores the resulting
C     frame into *GFVP*.  Private index strides are inlined [I].
      SUBROUTINE MNMX(N, X, Y)
      INTEGER N, I
      REAL X(1000), Y(1000), XMIN, XMAX, YMIN, YMAX, R
      COMMON /GFVP/ GFVP(6)
      XMIN = X(1)
      XMAX = X(1)
      YMIN = Y(1)
      YMAX = Y(1)
      DO 10 I = 2, N
         IF (X(I) .LT. XMIN) XMIN = X(I)
         IF (X(I) .GT. XMAX) XMAX = X(I)
         IF (Y(I) .LT. YMIN) YMIN = Y(I)
         IF (Y(I) .GT. YMAX) YMAX = Y(I)
10    CONTINUE
      CALL MAP(XMIN, XMAX, YMIN, YMAX)
      CALL LIMITS(XMIN, XMAX, YMIN, YMAX)
      GFVP(1) = XMIN
      GFVP(2) = XMAX
      GFVP(3) = YMIN
      GFVP(4) = YMAX
      IF (YMAX .NE. YMIN) R = (XMAX - XMIN)/(YMAX - YMIN)
      GFVP(5) = R
      RETURN
      END
