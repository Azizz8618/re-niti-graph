C HCPRSP - perspective setup: normalise a matrix row and call HCMULT.
C     GAK/2 = *GFMATR*+16, GAK/7 = GAK/2+13, GAK/3 = +32, GAK/4 = +33.
C     HCMULT and HCUNIT are MADLEN SUBP points of the same module.
C [I] the exact row/column layout of GFMATR is not documented;
C     the translation follows the arithmetic order of the listing.
      SUBROUTINE HCPRSP(S)
      REAL QQ1
      INTEGER I
      REAL S, SUM, W
      COMMON /GFMATR/ GFMATR(34)
C     Main body (MADLEN *0001B).
      DO 5 II = 17, 30
         GFMATR(II) = GFMATR(II) / S
    5 CONTINUE
      SUM = GFMATR(17)
      W = GFMATR(18) + GFMATR(19) + GFMATR(20) + GFMATR(21)
      DO 10 I = 22, 29
         SUM = SUM + GFMATR(I)
   10 CONTINUE
      GFMATR(30) = SUM / W
      DO 6 II = 33, 34
         GFMATR(II) = GFMATR(II) * S
    6 CONTINUE
      RETURN
      ENTRY HCMULT(QQ1)
      RETURN
      ENTRY HCUNIT(QQ1)
      RETURN
      END
