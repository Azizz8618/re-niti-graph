C     AXONOM - axonometric projection matrix update via HCROT1.
      SUBROUTINE AXONOM(ANG)
      REAL ANG
      COMMON /GFMATR/ GFMATR(34)
      REAL S, C, T(4,4)
      INTEGER I, J, K
      CALL AXUNIT(T)
      C = COS(ANG)
      S = SIN(ANG)
      T(1,1) = C
      T(1,2) = S
      T(2,1) = -S
      T(2,2) = C
      DO 20 I = 1, 3
         DO 20 J = 1, 3
            T(3,J) = 0.0
   20 CONTINUE
      T(3,3) = 1.0
      DO 40 I = 1, 3
         DO 40 J = 1, 3
            S = 0.0
            DO 30 K = 1, 3
               S = S + T(I,K)*GFMATR(4*(K-1)+J)
   30       CONTINUE
            GFMATR(4*(I-1)+J) = S
   40 CONTINUE
      RETURN
      END
      SUBROUTINE AXUNIT(T)
      REAL T(4,4)
      INTEGER I, J
      DO 10 I = 1, 4
         DO 10 J = 1, 4
            T(I,J) = 0.0
   10 CONTINUE
      DO 20 I = 1, 4
         T(I,I) = 1.0
   20 CONTINUE
      RETURN
      END
