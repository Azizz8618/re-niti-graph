C     WRMVE - general vector-element writer into *GFGEL*.
      SUBROUTINE WRMVE(X0, Y0, X1, Y1, MODE)
      REAL Q0
      REAL Q1
      INTEGER Q2
      REAL Q3
      REAL X0, Y0, X1, Y1, MODE
      COMMON /GFGEL/ GFGEL(28)
      REAL SC, T
      REAL U
      REAL R
      INTEGER K
      SC = MODE
      IF (SC .LT. 0.0) SC = -SC
      GFGEL(1) = X0
      GFGEL(2) = Y0
      GFGEL(3) = X1
      GFGEL(4) = Y1
      T = X1 - X0
      GFGEL(6) = T
      T = Y1 - Y0
      GFGEL(7) = T
      GFGEL(8) = SC
      GFGEL(9) = MODE
      RETURN
      ENTRY ABS(Q0)
      IF (Q0 .LT. 0.0) Q0 = -Q0
      RETURN
      ENTRY RSTI(Q1, Q2, Q3)
      Q3 = Q1*FLOAT(Q2)
      RETURN
      END
