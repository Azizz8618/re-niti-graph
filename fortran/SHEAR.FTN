C     SHEAR - apply a shear to the 4x4 homogeneous matrix *GFMATR*.
C     Identity is built with HCUNIT, then composed via HCMULT.
      SUBROUTINE SHEAR(SHX, SHY)
      REAL SHX, SHY
      COMMON /GFMATR/ GFMATR(34)
      REAL T(16), H(16)
      INTEGER I, J, K
      CALL SHUNIT(T)
      DO 10 I = 1, 4
         DO 10 J = 1, 4
            H(4*(I-1)+J) = 0.0
   10 CONTINUE
      DO 20 I = 1, 4
         H(4*(I-1)+I) = 1.0
   20 CONTINUE
      H(2) = SHX
      H(3) = SHY
      CALL SHMULT(T, H, T)
      DO 30 I = 1, 16
         GFMATR(I) = T(I)
   30 CONTINUE
      RETURN
      ENTRY IMUI(I, J, K)
      INTEGER I, J, K
      K = I*J
      RETURN
      END
      SUBROUTINE SHUNIT(A)
      REAL A(16)
      INTEGER I, J
      DO 10 I = 1, 4
         DO 10 J = 1, 4
            A(4*(I-1)+J) = 0.0
   10 CONTINUE
      DO 20 I = 1, 4
         A(4*(I-1)+I) = 1.0
   20 CONTINUE
      RETURN
      END
      SUBROUTINE SHMULT(A, B, C)
      REAL A(16), B(16), C(16)
      INTEGER I, J, K
      REAL S
      DO 10 I = 1, 4
         DO 10 J = 1, 4
            S = 0.0
            DO 5 K = 1, 4
               S = S + A(4*(I-1)+K)*B(4*(K-1)+J)
    5       CONTINUE
            C(4*(I-1)+J) = S
   10 CONTINUE
      RETURN
      END
