C     TDSECT - draw a 3D surface section.
C     Points are transformed with HCNCRD, clipped against *GFLIM*
C     using ZINT interpolation and emitted with HCLINE.
      SUBROUTINE TDSECT(N, X, Y, Z, XO, YO)
      REAL Q0
      REAL Q1
      REAL Q2
      REAL Q3
      REAL Q4
      REAL Q5
      REAL Q6
      REAL Q7
      REAL Q8
      REAL Q9
      INTEGER Q10
      REAL Q11
      REAL Q12
      REAL Q13
      INTEGER Q14
      INTEGER Q15
      INTEGER Q16
      INTEGER Q17
      INTEGER Q18
      INTEGER N
      REAL X(1000), Y(1000), Z(1000), XO(1000), YO(1000)
      REAL U, V, W, R, A, B
      INTEGER I
      COMMON /GFMATR/ GFMATR(34)
      COMMON /GFCRD/ GFCRD(3)
      COMMON /GFSUR/ GFSUR(4)
      COMMON /GFLIM/ GFLIM(4)
      REAL XA, YA, ZA
      REAL C
      INTEGER J
      INTEGER K
      DO 20 I = 1, N
         CALL TDCRD(X(I), Y(I), Z(I), U, V, W)
         IF (U .LT. GFLIM(1)) THEN
            CALL TDZIN(GFLIM(1), U, X(I), R)
            U = GFLIM(1)
            V = V + R*(Y(I)-V)
         END IF
         IF (U .GT. GFLIM(2)) THEN
            CALL TDZIN(GFLIM(2), U, X(I), R)
            U = GFLIM(2)
            V = V + R*(Y(I)-V)
         END IF
         IF (V .LT. GFLIM(3)) V = GFLIM(3)
         IF (V .GT. GFLIM(4)) V = GFLIM(4)
         XO(I) = U
         YO(I) = V
   20 CONTINUE
      CALL TDSL1(N, XO, YO)
      RETURN
      ENTRY HCNCRD(Q0, Q1, Q2, Q3, Q4, Q5)
      CALL TDCRD(Q0, Q1, Q2, Q3, Q4, Q5)
      RETURN
      ENTRY ZINT(Q6, Q7, Q8, Q9)
      CALL TDZIN(Q6, Q7, Q8, Q9)
      RETURN
      ENTRY HCLINE(Q10, Q11, Q12)
      CALL TDSL1(Q10, Q11, Q12)
      RETURN
      ENTRY ABS(Q13)
      IF (Q13 .LT. 0.0) Q13 = -Q13
      RETURN
      ENTRY IABS(Q14, Q15)
      Q15 = Q14
      IF (Q15 .LT. 0) Q15 = -Q15
      RETURN
      ENTRY IMUI(Q16, Q17, Q18)
      Q18 = Q16*Q17
      RETURN
      END
      SUBROUTINE TDCRD(X, Y, Z, U, V, W)
      REAL X, Y, Z, U, V, W
      COMMON /GFMATR/ GFMATR(34)
      U = GFMATR(1)*X + GFMATR(2)*Y + GFMATR(3)*Z + GFMATR(4)
      V = GFMATR(5)*X + GFMATR(6)*Y + GFMATR(7)*Z + GFMATR(8)
      W = GFMATR(9)*X + GFMATR(10)*Y + GFMATR(11)*Z + GFMATR(12)
      IF (W .NE. 0.0) THEN
         U = U/W
         V = V/W
      END IF
      RETURN
      END
      SUBROUTINE TDZIN(A, B, C, R)
      REAL A, B, C, R
      IF (C .EQ. B) THEN
         R = 0.0
      ELSE
         R = (A - B)/(C - B)
      END IF
      RETURN
      END
      SUBROUTINE TDSL1(N, X, Y)
      INTEGER N
      REAL X(1000), Y(1000)
      INTEGER I
      DO 10 I = 1, N
         CALL PLOT()
   10 CONTINUE
      RETURN
      END
