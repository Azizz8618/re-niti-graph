      SUBROUTINE RCATAL(K)
      INTEGER Q0
      INTEGER Q1
      COMMON /LICAT/ LICAT(1)
      INTEGER K, I
C     Read the library catalog and dispatch to the zone primitives.
C [I] The catalog is an absolute disk area in MADLEN; EXC70 models
C     the physical exchange, LICAT(1) is the current catalog word.
      CALL EXC70(K)
      DO 10 I = 1, 16
         IF (LICAT(1) .EQ. K) GO TO 20
10    CONTINUE
      RETURN
20    CALL EXC70(K)
      RETURN
C     Zone primitives: reference-only entries in the DMS library.
      ENTRY RZONE(Q0)
      CALL EXC70(Q0)
      RETURN
      ENTRY WZONE(Q1)
      CALL EXC70(Q1)
      RETURN
      END
