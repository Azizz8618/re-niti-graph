C     HISTGM - draw a histogram with automatic scaling.
C     Reads two counts through IRDB, transforms the baseline with TMF,
C scales each height with ABS/R*ST*I and draws zero/positive/negative
C     bars as four-segment rectangles with MOVE.
C [I] bar width and baseline offset come from the constants of the
C listing.
C [I] MADLEN math SUBP names (ABS, SQRT, SIN, COS, ATAN, AINT, IABS,
C     SIGN, AMOD, AMAX1, AMIN1, FLOAT, ALOG10, MAX0, MIN0) are mapped to
C     the Fortran intrinsics; no ENTRY is generated for them.
      SUBROUTINE HISTGM(N,X,Y,H)
      REAL QQ1, QQ2, QQ3, QQ4
      INTEGER N, IV, IW, I
      REAL X(1), Y(1), H(1), X0, Y0, X1, Y1, W, S, T, A, B, C, D
      IV = 0
      IW = 1
      IF (N .LE. 0) RETURN
      W = 1.0
      S = 1.0
      IF (IW .NE. 0) S = FLOAT(IW)
      X0 = X(1)
      Y0 = Y(1)
      CONTINUE
      DO 10 I = 1, N
         T = H(I) * S
         IF (T .LT. 0.0) T = -T
         X1 = X(I) + W
         Y1 = Y(I) + T
         X0 = X(I)
         Y0 = Y(I)
         CONTINUE
         CONTINUE
         CONTINUE
         CONTINUE
         IF (H(I) .GE. 0.0) THEN
            CONTINUE
         ELSE
            CONTINUE
         END IF
   10 CONTINUE
      RETURN
      ENTRY IRDB(QQ1)
      QQ1 = 0
      RETURN
      ENTRY TMF(QQ1,QQ2,QQ3,QQ4)
      QQ3 = QQ1
      QQ4 = QQ2
      RETURN
      ENTRY RSTI(QQ1,QQ2)
      QQ2 = QQ1
      RETURN
      END
