C     ITPLBV - table interpolation with validation (MADLEN ITPLBV).
C     Checks LX, LY and N, verifies monotone X/Y tables without
C     duplicate abscissae, searches the interval and interpolates.
C     The 16 flag-dependent interpolation branches of the original
C     are collapsed to linear interpolation [I]; the diagnostic
C     FORMAT texts are preserved.
      SUBROUTINE ITPLBV(XV, YV, XT, YT, LX, LY, N, IER)
      INTEGER LX, LY, N, IER, I, J
      REAL XV, YV, XT(1000), YT(1000), T, W
      IER = 0
      IF (LX .LE. 1) THEN
         WRITE(54,900)
         IER = 1
         RETURN
      END IF
      IF (LY .LE. 1) THEN
         WRITE(54,901)
         IER = 2
         RETURN
      END IF
      IF (N .LE. 0) THEN
         WRITE(54,902)
         IER = 3
         RETURN
      END IF
      DO 10 I = 2, N
         IF (XT(I) .EQ. XT(I-1)) THEN
            WRITE(54,903)
            IER = 4
            RETURN
         END IF
         IF (XT(I) .LT. XT(I-1)) THEN
            WRITE(54,904)
            IER = 5
            RETURN
         END IF
10    CONTINUE
      DO 20 I = 2, LY
         IF (YT(I) .EQ. YT(I-1)) THEN
            WRITE(54,905)
            IER = 6
            RETURN
         END IF
         IF (YT(I) .LT. YT(I-1)) THEN
            WRITE(54,906)
            IER = 7
            RETURN
         END IF
20    CONTINUE
      J = 1
      DO 30 I = 2, N
         IF (XV .GE. XT(I)) J = I
30    CONTINUE
      IF (J .LT. N) THEN
         T = (XV - XT(J))/(XT(J+1) - XT(J))
         W = YT(J) + T*(YT(J+1) - YT(J))
      ELSE
         W = YT(N)
      END IF
      YV = W
      RETURN
900   FORMAT(34H *** LX=1 OR LESS. ERROR IN ITPLBV)
901   FORMAT(34H *** LY=1 OR LESS. ERROR IN ITPLBV)
902   FORMAT(35H *** N = 0 OR LESS. ERROR IN ITPLBV)
903   FORMAT(40H *** IDENTICAL X VALUES. ERROR IN ITPLBV)
904   FORMAT(46H *** X VALUES OUT OF SEQUENCE. ERROR IN ITPLBV)
905   FORMAT(40H *** IDENTICAL Y VALUES. ERROR IN ITPLBV)
906   FORMAT(46H *** Y VALUES OUT OF SEQUENCE. ERROR IN ITPLBV)
      END
