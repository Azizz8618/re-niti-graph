C     HCUNIT - normalize a 3-vector to unit length (MADLEN HCUNIT).
C     The MADLEN I*MUI* multiplication is replaced by direct
C     floating-point arithmetic [I].
      SUBROUTINE HCUNIT(V)
      REAL V(1000), S
      S = SQRT(V(1)*V(1) + V(2)*V(2) + V(3)*V(3))
      IF (S .NE. 0.0) THEN
         V(1) = V(1)/S
         V(2) = V(2)/S
         V(3) = V(3)/S
      END IF
      RETURN
      END
