C     SMTBVF - 2-D vector field fitting (N,LX,LY,X,Y,U,V).
C     The original is a 2154-command Fortran-compiled kernel; here the
C     validation and the coefficient accumulation are kept, while the
C     machine-dependent coefficient algebra is approximated [I].
      SUBROUTINE SMTBVF(N, LX, LY, LP0, X, Y, U, V, C)
      INTEGER N, LX, LY, LP0, I, J, K, IX, IY, K1, K2
      REAL X(*), Y(*), U(*), V(*), C(*)
      REAL TX, TY, WX(4), WY(4), P, T
      INTEGER IMIN, JMIN
      EXTERNAL OPER
      IF (N .LT. 1) GO TO 900
      IF (LX .LT. LP0+2) GO TO 910
      IF (LY .LT. LP0+2) GO TO 920
      DO 10 I = 1, LX-1
         IF (X(I) .EQ. X(I+1)) GO TO 930
         IF (X(I) .GT. X(I+1)) GO TO 940
   10 CONTINUE
      DO 20 J = 1, LY-1
         IF (Y(J) .EQ. Y(J+1)) GO TO 950
         IF (Y(J) .GT. Y(J+1)) GO TO 960
   20 CONTINUE
      DO 30 K = 1, 16
   30 C(K) = 0.
      DO 100 K = 1, N
         IX = 1
         IY = 1
         DO 40 I = 1, LX-1
            IF (X(K) .GE. X(I)) IX = I
   40    CONTINUE
         DO 50 J = 1, LY-1
            IF (Y(K) .GE. Y(J)) IY = J
   50    CONTINUE
         TX = 0.
         TY = 0.
         IF (X(IX+1) .NE. X(IX)) TX = (X(K)-X(IX))/(X(IX+1)-X(IX))
         IF (Y(IY+1) .NE. Y(IY)) TY = (Y(K)-Y(IY))/(Y(IY+1)-Y(IY))
         WX(1) = (1.-TX)*(1.-TX)
         WX(2) = 2.*TX*(1.-TX)
         WX(3) = TX*TX
         WX(4) = 0.
         WY(1) = (1.-TY)*(1.-TY)
         WY(2) = 2.*TY*(1.-TY)
         WY(3) = TY*TY
         WY(4) = 0.
         IMIN = IX
         JMIN = IY
         DO 80 I = 1, 3
            DO 70 J = 1, 3
               K1 = (IMIN-1)*3 + I
               K2 = (JMIN-1)*3 + J
               P = WX(I)*WY(J)
               C(K1) = C(K1) + P*U(K)
               IF (K2 .LE. 16) C(K2) = C(K2) + P*V(K)
   70       CONTINUE
   80    CONTINUE
         CALL OPER(C(1), U(K), V(K), K)
  100 CONTINUE
      RETURN
C     Diagnostics (ISO formats at SMTBVF.mad:2097-2139).
  900 CALL FT571
      CALL FT003
      RETURN
  910 CALL FT571
      CALL FT002(N)
      CALL FT002(LX)
      CALL FT003
      RETURN
  920 CALL FT571
      CALL FT002(N)
      CALL FT002(LY)
      CALL FT003
      RETURN
  930 CALL FT571
      CALL FT002(I)
      CALL FT003
      RETURN
  940 CALL FT571
      CALL FT002(I)
      CALL FT003
      RETURN
  950 CALL FT571
      CALL FT002(J)
      CALL FT003
      RETURN
  960 CALL FT571
      CALL FT002(J)
      CALL FT003
      RETURN
      END
