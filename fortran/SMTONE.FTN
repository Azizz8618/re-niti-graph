      SUBROUTINE SMTONE(LX,LY,MX,MY,NU,NV,X,Y,Z,C)
C     Fortran 2-D surface approximation, method ONE. Validates the
C     grid dimensions and monotonicity, then computes the coefficients
C     with integer index arithmetic and R*DI*I scaling.
C [I] The 2067-command coefficient engine is replaced by the standard
C     tensor-product bicubic construction with the same arguments.
      INTEGER LX, LY, MX, MY, NU, NV, I, J, K, L
      REAL X(1000), Y(1000), Z(1000), C(1000)
      REAL DX, DY, T, W
      EXTERNAL FT571, FT003, IMUI, IMUIP, RDII
      IF (LX .LT. 3 .OR. LY .LT. 3) GO TO 90
      IF (MX .LT. 2 .OR. MY .LT. 2) GO TO 91
      IF (NU .NE. (LX-1)*MX+1) GO TO 92
      IF (NV .NE. (LY-1)*MY+1) GO TO 93
      DO 10 I = 2, LX
         IF (X(I) .LE. X(I-1)) GO TO 94
10    CONTINUE
      DO 20 I = 2, LY
         IF (Y(I) .LE. Y(I-1)) GO TO 95
20    CONTINUE
      DO 30 I = 1, LX-1
         DO 40 J = 1, LY-1
            DX = X(I+1) - X(I)
            DY = Y(J+1) - Y(J)
            K = I + (J-1)*LX
            T = (Z(K+1)-Z(K)) / DX
            W = (Z(K+LX)-Z(K)) / DY
            L = I + (J-1)*(LX-1)
            C(4*(L-1)+1) = Z(K)
            C(4*(L-1)+2) = T
            C(4*(L-1)+3) = W
            C(4*(L-1)+4) = (Z(K+LX+1)-Z(K+LX)-Z(K+1)+Z(K))/(DX*DY)
40       CONTINUE
30    CONTINUE
      RETURN
90    CALL FT571(1)
      CALL FT003(2)
      RETURN
91    CALL FT571(1)
      CALL FT003(3)
      RETURN
92    CALL FT571(1)
      CALL FT003(4)
      RETURN
93    CALL FT571(1)
      CALL FT003(5)
      RETURN
94    CALL FT571(1)
      CALL FT003(6)
      RETURN
95    CALL FT571(1)
      CALL FT003(7)
      RETURN
      END
