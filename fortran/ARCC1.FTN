      SUBROUTINE ARCC1(X1, Y1, X2, Y2, X3, Y3, XC, YC, RAD, ANG)
C     Circle through three points (ARCC1.mad): forms squared side
C     lengths, applies a Heron-type expression, converts with R*DI*I,
C     obtains the angle with ATAN and returns centre, radius and angle
C     through six indirect pointer cells [I].
      REAL X1, Y1, X2, Y2, X3, Y3, XC, YC, RAD, ANG
      REAL A, B, C, S, AREA, D, T
      A = SQRT((X2-X1)**2 + (Y2-Y1)**2)
      B = SQRT((X3-X2)**2 + (Y3-Y2)**2)
      C = SQRT((X1-X3)**2 + (Y1-Y3)**2)
      S = (A + B + C) / 2.0
      AREA = SQRT(S*(S-A)*(S-B)*(S-C))
      IF (AREA .EQ. 0.0) GOTO 20
      D = 4.0 * AREA
      XC = (A*A*(X3-X2)*(X1-X2) + C*C*(X2-X1)*(X3-X2)) / (2.0*D)
      YC = (A*A*(Y3-Y2)*(Y1-Y2) + C*C*(Y2-Y1)*(Y3-Y2)) / (2.0*D)
      XC = XC + X2
      YC = YC + Y2
      RAD = A*B*C / D
      T = X3 - XC
      ANG = ATAN2(Y3 - YC, T)
      RETURN
   20 XC = X1
      YC = Y1
      RAD = 0.0
      ANG = 0.0
      RETURN
      END
