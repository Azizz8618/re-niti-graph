C     SETK - catalog chain dispatcher (GDISC -> RCATAL -> SETEND
C     -> WCATAL -> FDISC). In SETK.mad the five steps are declared
C     as SUBP entries of this module, but each also exists as a
C     separate module/entry in other batches, so calling them as
C     external subroutines avoids duplicate global symbols.
C [I] The original passes one argument word through BSS *0032B..;
C     here a single integer word IC is passed to every step.
      SUBROUTINE SETK
      INTEGER IC
      IC = 0
      CALL GDISC(IC)
      CALL RCATAL(IC)
      CALL SETEND(IC,IC)
      CALL WCATAL(IC)
      CALL FDISC(IC)
      RETURN
      END
