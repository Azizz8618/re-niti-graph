C     RENTCH - renumber the *GFGOBS* object table, re-indexing
C     *GFATRN* entries by division and multiplication with 8 and 4.
      SUBROUTINE RENTCH(NOBJ)
      INTEGER NOBJ, I, J, K, N8, N4
      COMMON /GFATRN/ GFATRN(7)
      COMMON /GFGOBS/ GFGOBS(20)
      INTEGER IT(16)
      DATA IT /16*8/
      N8 = 8
      N4 = 4
      DO 10 I = 1, NOBJ
         IF (GFGOBS(2) .NE. 0.0) THEN
            J = GFGOBS(2) / N8
            K = (GFGOBS(4) / N8) * N4
            GFGOBS(5) = J + K
            GFGOBS(3) = GFGOBS(5)
            IF (GFGOBS(3) .GT. GFGOBS(2)) THEN
               GFGOBS(3) = GFGOBS(5)
            END IF
            IF (GFGOBS(3) .LT. GFGOBS(2)) THEN
               GFGOBS(4) = GFGOBS(3)
            END IF
            IF (I .LE. 16) GFATRN(1) = IT(I)
         END IF
         GFGOBS(2) = GFGOBS(2) - 1.0
   10 CONTINUE
      RETURN
      END
