C     THAXES - draw a 3D axis system with ticks and numeric labels.
C     Ticks are transformed with TPF/TPF-like projection, drawn with
C     CIRCLE/MOVE and labelled with NUMBER.
      SUBROUTINE THAXES(N, X, Y, Z, TICK)
      REAL Q0
      REAL Q1
      REAL Q2
      REAL Q3
      REAL Q4
      REAL Q5
      REAL Q6
      REAL Q7
      REAL Q8
      REAL Q9
      INTEGER Q10
      REAL Q11
      INTEGER Q12
      REAL Q13
      REAL Q14
      INTEGER Q15
      REAL Q16
      REAL Q17
      INTEGER Q18
      REAL Q19
      REAL Q20
      REAL Q21
      INTEGER N
      REAL X(1000), Y(1000), Z(1000), TICK
      REAL A, B, R, S, C, V, X0, Y0
      INTEGER I, J, NT
      COMMON /GFVP/ GFVP(6)
      COMMON /GFBFTR/ GFBFTR(2)
      REAL U
      INTEGER K
      IF (N .LE. 0 .OR. TICK .LE. 0.0) RETURN
      X0 = GFVP(1)
      Y0 = GFVP(3)
      NT = INT((GFVP(2)-GFVP(1))/TICK)
      IF (NT .LT. 1) NT = 1
      IF (NT .GT. 100) NT = 100
      DO 30 J = 1, 3
         DO 20 I = 1, NT
            A = FLOAT(I)*TICK
            IF (J .EQ. 1) THEN
               V = X0 + A
               B = Y0
            ELSE IF (J .EQ. 2) THEN
               V = X0
               B = Y0 + A
            ELSE
               CALL THTPF(A, R)
               V = X0 + A*R
               B = Y0 + A*(1.0-R)
            END IF
            CALL PLOT()
            CALL PLOT()
   20    CONTINUE
   30 CONTINUE
      RETURN
      ENTRY AMAX1(Q0, Q1, Q2)
      Q2 = Q0
      IF (Q1 .GT. Q2) Q2 = Q1
      RETURN
      ENTRY AMIN1(Q3, Q4, Q5)
      Q5 = Q3
      IF (Q4 .LT. Q5) Q5 = Q4
      RETURN
      ENTRY AMOD(Q6, Q7, Q8)
      Q8 = Q6 - INT(Q6/Q7)*Q7
      RETURN
      ENTRY ABS(Q9)
      IF (Q9 .LT. 0.0) Q9 = -Q9
      RETURN
      ENTRY RDB(Q10, Q11)
      Q11 = GFBFTR(Q10)
      RETURN
      ENTRY IRDB(Q12, Q13)
      Q13 = FLOAT(Q12)
      RETURN
      ENTRY RPOI(Q14, Q15, Q16)
      Q16 = Q14**Q15
      RETURN
      ENTRY RDII(Q17, Q18, Q19)
      Q19 = Q17/FLOAT(Q18)
      RETURN
      ENTRY MOVE(Q20, Q21)
      CALL PLOT()
      RETURN
      END
      SUBROUTINE THTPF(A, R)
      REAL A, R
      R = (1.0 + COS(A))/2.0
      RETURN
      END
