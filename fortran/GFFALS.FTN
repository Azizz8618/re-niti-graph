C     GFFALS - GRAFOR error reporter, eight messages selected by code.
C     Message text is kept as short FORMAT records instead of ISO words.
      SUBROUTINE GFFALS(IER)
      INTEGER IER, GFGOBS
      COMMON /GFGOBS/ GFGOBS(20)
      GO TO (10, 20, 30, 40, 50, 60, 70, 80), IER
   10 PRINT 100
      GO TO 90
   20 PRINT 101
      GO TO 90
   30 PRINT 102, GFGOBS(1)
      GO TO 90
   40 PRINT 103
      GO TO 90
   50 PRINT 104
      GO TO 90
   60 PRINT 105
      GO TO 90
   70 PRINT 106
      GO TO 90
   80 PRINT 107
   90 CALL ENDPG
      RETURN
  100 FORMAT(6X,'TOO MANY BRACKETS')
  101 FORMAT(6X,'WRONG NUMBER OF BRACKETS')
  102 FORMAT(6X,'BANK NUMBER OVERFLOW',I2)
  103 FORMAT(6X,'NUMBER OF SCREENS TOO LARGE')
  104 FORMAT(6X,'NUMBER OF BANKS TOO LARGE')
  105 FORMAT(6X,'WRONG PARAMETERS')
  106 FORMAT(6X,'WRONG GEOMETRIC ELEMENT')
  107 FORMAT(6X,'ALL POINTS WERE BLANKED')
      END
