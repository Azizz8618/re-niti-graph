C     MOVE3 - combined blanking/notch polyline plotter (MADLEN MOVE3).
C     Reads points with RDB, applies the affine transform, advances
C     the gap/notch counters with NOTCH1 and emits points with PLOT.
C     The load-time ,DATA, defaults are installed by BLOCK DATA [I].
      SUBROUTINE MOVE3(N, X, Y)
      INTEGER N, I
      REAL X(1000), Y(1000), U, V, A, B
      COMMON /GFATRN/ GFATRN(7)
      COMMON /GFBLAN/ GFBLAN(11)
      COMMON /GFGOBS/ GFGOBS(20)
      COMMON /GFNTCH/ GFNTCH(51)
      COMMON /GFAFTR/ GFAFTR(2)
      DO 10 I = 1, N
         U = GFATRN(1)*X(I) + GFATRN(3)*Y(I) + GFATRN(5)
         V = GFATRN(2)*X(I) + GFATRN(4)*Y(I) + GFATRN(6)
         A = AMAX1(GFBLAN(1), U)
         B = AMAX1(GFBLAN(1), V)
         GFGOBS(3) = GFGOBS(3) + 1
         CALL NOTCH1()
         CALL PLOT()
         GFAFTR(1) = A
         GFAFTR(2) = B
10    CONTINUE
      RETURN
      END

      BLOCK DATA BDVM3
      COMMON /GFBLAN/ GFBLAN(11)
      COMMON /GFATRN/ GFATRN(7)
      COMMON /GFGOBS/ GFGOBS(20)
      COMMON /GFNTCH/ GFNTCH(51)
      REAL GFBLAN, GFATRN, GFGOBS, GFNTCH
      DATA GFBLAN /11*0.0/
      DATA GFATRN /1.0, 2*0.0, 1.0, 3*0.0/
      DATA GFGOBS /20*0.0/
      DATA GFNTCH(51) /0.0/
      END
