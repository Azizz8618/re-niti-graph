C     RDMVA - read a vector record: two points, length and direction.
      SUBROUTINE RDMVA(OUT)
      REAL Q0
      INTEGER Q1
      REAL Q2
      REAL Q3
      REAL Q4
      REAL OUT(4)
      COMMON /GFGEL/ GFGEL(28)
      REAL DX, DY, R
      REAL A
      INTEGER K
      DX = GFGEL(6) - GFGEL(2)
      DY = GFGEL(7) - GFGEL(1)
      OUT(1) = GFGEL(1)
      OUT(2) = GFGEL(2)
      R = (DX*DX + DY*DY)**0.5
      OUT(3) = R
      IF (R .EQ. 0.0) THEN
         OUT(4) = 0.0
      ELSE
         OUT(4) = ATAN2(DY, DX)
      END IF
      RETURN
      ENTRY RSTI(Q0, Q1, Q2)
      Q2 = Q0*FLOAT(Q1)
      RETURN
      ENTRY ABS(Q3)
      IF (Q3 .LT. 0.0) Q3 = -Q3
      RETURN
      ENTRY SQRT(Q4)
      IF (Q4 .GT. 0.0) Q4 = Q4**(0.5)
      RETURN
      END
