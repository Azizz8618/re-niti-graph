C     ARCIA - principal arc interpolator; emits points with MOVE.
      SUBROUTINE ARCIA(X0, Y0, A0, DA, N)
      REAL Q0
      REAL Q1
      INTEGER Q2
      REAL Q3
      REAL Q4
      REAL Q5
      INTEGER Q6
      REAL Q7
      REAL Q8
      REAL Q9
      REAL Q10
      REAL Q11
      REAL X0, Y0, A0, DA
      INTEGER N
      REAL A, S, C, R, X, Y
      INTEGER I
      COMMON /GFBFTR/ GFBFTR(2)
      COMMON /GFAFTR/ GFAFTR(2)
      REAL B
      INTEGER K
      REAL V
      R = GFBFTR(1)
      IF (R .LT. 0.0) R = -R
      A = A0
      DO 20 I = 1, N
         CALL ARCTG(A, S, C)
         X = X0 + R*C
         Y = Y0 + R*S
         GFAFTR(1) = X
         GFAFTR(2) = Y
         CALL PLOT()
         A = A + DA
   20 CONTINUE
      RETURN
      ENTRY MOVE(Q0, Q1)
      GFAFTR(1) = Q0
      GFAFTR(2) = Q1
      CALL PLOT()
      RETURN
      ENTRY RDB(Q2, Q3)
      Q3 = GFBFTR(Q2)
      RETURN
      ENTRY ABS(Q4)
      IF (Q4 .LT. 0.0) Q4 = -Q4
      RETURN
      ENTRY RSTI(Q5, Q6, Q7)
      Q7 = Q5*FLOAT(Q6)
      RETURN
      ENTRY SIN(Q8, Q9)
      CALL ARCTG(Q8, Q9, C)
      RETURN
      ENTRY COS(Q10, Q11)
      CALL ARCTG(Q10, S, Q11)
      RETURN
      END
      SUBROUTINE ARCTG(A, S, C)
      REAL A, S, C
      S = SIN(A)
      C = COS(A)
      RETURN
      END
