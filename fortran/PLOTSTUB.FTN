C     Physical level of the GRAFOR plotter: external entry points from
C     the secondary catalog of library 22 (zone 0o1163 of volume 2048).
C
C     The real device driver is NOT part of library 22. Library modules
C     (MOVE1/2/3, STRMOD, MOVA, DASHP, ...) only compute coordinates and
C     transfer control to these entry points. These stubs let the ported
C     Fortran library run under FOREX 4.12 without a physical plotter;
C     each call is counted in /TRACE/.
C
C     Names are limited to 6 characters. Long catalog names are mapped:
C       ONOFF -> ONOFF, FRAGM -> FRAGM, EFRAGM -> EFRAGM,
C       GROPEN -> GROPEN (6), GRWRIT -> GRWRIT (6),
C       GRCLOS -> GRCLOS (6), GRNOTZ -> GRNOTZ (6),
C       GRNAME -> GRNAME (6), WRITC -> WRITC, ENDPG -> ENDPG,
C       PAGE -> PAGE, IDENT -> IDENT, ITALIC -> ITALIC (6),
C       PLOT -> PLOT, PEN -> PEN, SET -> SET.
C
C     PLOT -> PDEV frame contract (agreed with dispak/dispak/extra.c):
C       /PDEVXY/ holds INTEGER X/Y in 0.1 mm steps and the pen state.
C       PDEV is MADLEN and cannot resolve FOREX COMMON symbols by name,
C       so PLOT passes the frame address as its single argument instead of
C       relying on a fixed address: PDEV reads it from the accumulator and
C       no longer depends on how the linker lays out this deck. The frame
C       stays in /PDEVXY/ and still holds 64 words.
      SUBROUTINE PLOT()
      EXTERNAL PDEV
      COMMON /TRACE/ NEXC50, NEXC70, NEXC72, NEXC74, NPLOT
      COMMON /GFAFTR/ GFAFTR(2)
      COMMON /PDEVXY/ FRAME(64)
      INTEGER FRAME, I
      NPLOT = NPLOT + 1
C     MOVE/ARCIA store the point in /GFAFTR/ as REAL; the frame wants an
C     octal integer count of 0.1 mm steps.  PLOT means "pen down".
C     Words 4..64 must be cleared explicitly: MADLEN BSS is not zeroed.
      DO 10 I = 4, 64
         FRAME(I) = 0
   10 CONTINUE
      FRAME(1) = INT(GFAFTR(1))
      FRAME(2) = INT(GFAFTR(2))
      FRAME(3) = 1
      CALL PDEV(FRAME(1))
      RETURN
      END

      SUBROUTINE PEN()
      COMMON /TRACE/ NEXC50, NEXC70, NEXC72, NEXC74, NPLOT
      RETURN
      END

      SUBROUTINE ONOFF()
      COMMON /TRACE/ NEXC50, NEXC70, NEXC72, NEXC74, NPLOT
      RETURN
      END

      SUBROUTINE FRAME()
      COMMON /TRACE/ NEXC50, NEXC70, NEXC72, NEXC74, NPLOT
      RETURN
      END

      SUBROUTINE FRAGM()
      COMMON /TRACE/ NEXC50, NEXC70, NEXC72, NEXC74, NPLOT
      RETURN
      END

      SUBROUTINE EFRAGM()
      COMMON /TRACE/ NEXC50, NEXC70, NEXC72, NEXC74, NPLOT
      RETURN
      END

      SUBROUTINE GROPEN()
      COMMON /TRACE/ NEXC50, NEXC70, NEXC72, NEXC74, NPLOT
      RETURN
      END

      SUBROUTINE GRWRIT()
      COMMON /TRACE/ NEXC50, NEXC70, NEXC72, NEXC74, NPLOT
      RETURN
      END

      SUBROUTINE GRCLOS()
      COMMON /TRACE/ NEXC50, NEXC70, NEXC72, NEXC74, NPLOT
      RETURN
      END

      SUBROUTINE GRNOTZ()
      COMMON /TRACE/ NEXC50, NEXC70, NEXC72, NEXC74, NPLOT
      RETURN
      END

      SUBROUTINE GRNAME()
      COMMON /TRACE/ NEXC50, NEXC70, NEXC72, NEXC74, NPLOT
      RETURN
      END

      SUBROUTINE WRITC()
      COMMON /TRACE/ NEXC50, NEXC70, NEXC72, NEXC74, NPLOT
      RETURN
      END

      SUBROUTINE ENDPG()
      COMMON /TRACE/ NEXC50, NEXC70, NEXC72, NEXC74, NPLOT
      RETURN
      END

      SUBROUTINE PAGE()
      COMMON /TRACE/ NEXC50, NEXC70, NEXC72, NEXC74, NPLOT
      RETURN
      END

      SUBROUTINE SET()
      COMMON /TRACE/ NEXC50, NEXC70, NEXC72, NEXC74, NPLOT
      RETURN
      END

      SUBROUTINE IDENT()
      COMMON /TRACE/ NEXC50, NEXC70, NEXC72, NEXC74, NPLOT
      RETURN
      END

      SUBROUTINE ITALIC()
      COMMON /TRACE/ NEXC50, NEXC70, NEXC72, NEXC74, NPLOT
      RETURN
      END
