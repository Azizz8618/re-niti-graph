      RETURN
      END

      SUBROUTINE GRWRIT()
      COMMON /TRACE/ NEXC50, NEXC70, NEXC72, NEXC74, NPLOT
      RETURN
      END

      SUBROUTINE GRCLOS()
      COMMON /TRACE/ NEXC50, NEXC70, NEXC72, NEXC74, NPLOT
      RETURN
      END

      SUBROUTINE GRNOTZ()
      COMMON /TRACE/ NEXC50, NEXC70, NEXC72, NEXC74, NPLOT
