      SUBROUTINE LININT(XA,YA,NA,XB,YB,NB,T,R)
C     Linear interpolation over two tables, duplicated in MADLEN for
C     increasing and decreasing abscissa order. No external calls.
      REAL XA(*), YA(*), XB(*), YB(*), T, R
      INTEGER NA, NB, I
      R = 0.0
      IF (NA .LT. 2) RETURN
      IF (XA(2) .GE. XA(1)) THEN
         DO 10 I = 1, NA-1
            IF (T .GE. XA(I) .AND. T .LE. XA(I+1)) THEN
               R = YA(I) + (YA(I+1)-YA(I))*(T-XA(I))/(XA(I+1)-XA(I))
               RETURN
            END IF
10       CONTINUE
      ELSE
         DO 20 I = 1, NA-1
            IF (T .LE. XA(I) .AND. T .GE. XA(I+1)) THEN
               R = YA(I) + (YA(I+1)-YA(I))*(T-XA(I))/(XA(I+1)-XA(I))
               RETURN
            END IF
20       CONTINUE
      END IF
      IF (NB .LT. 2) RETURN
      DO 30 I = 1, NB-1
         IF (T .GE. XB(I) .AND. T .LE. XB(I+1)) THEN
            R = YB(I) + (YB(I+1)-YB(I))*(T-XB(I))/(XB(I+1)-XB(I))
            RETURN
         END IF
30    CONTINUE
      RETURN
      END
