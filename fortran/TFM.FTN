C     TFM - transform/scale routine with FLOAT, ABS and RDB entries.
C     Computes the plotting scale from two reference readings.
      SUBROUTINE TFM(X0, Y0, X1, Y1, SX, SY, U, V)
      INTEGER Q0
      REAL Q1
      REAL Q2
      INTEGER Q3
      REAL Q4
      REAL X0, Y0, X1, Y1, SX, SY, U, V
      REAL DX, DY
      COMMON /GFBFTR/ GFBFTR(2)
      INTEGER I
      REAL R
      REAL X
      INTEGER K
      DX = X1 - X0
      DY = Y1 - Y0
      IF (DX .LT. 0.0) DX = -DX
      IF (DY .LT. 0.0) DY = -DY
      IF (SX .EQ. 0.0) SX = 1.0
      IF (SY .EQ. 0.0) SY = 1.0
      U = DX/SX
      V = DY/SY
      RETURN
      ENTRY FLOAT(Q0, Q1)
      Q1 = REAL(Q0)
      RETURN
      ENTRY ABS(Q2)
      IF (Q2 .LT. 0.0) Q2 = -Q2
      RETURN
      ENTRY RDB(Q3, Q4)
      Q4 = GFBFTR(Q3)
      RETURN
      END
