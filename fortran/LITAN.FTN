C     LITAN - tangent lines from a point to a circle from *GFGEL*.
      SUBROUTINE LITAN(XP, YP, XC, YC, R, X1, Y1, X2, Y2, IOK)
      REAL Q0
      REAL Q1
      REAL Q2
      REAL Q3
      REAL Q4
      REAL Q5
      REAL Q6
      REAL Q7
      REAL XP, YP, XC, YC, R, X1, Y1, X2, Y2
      INTEGER IOK
      REAL DX, DY, D2, L, T, U, V
      COMMON /GFBFTR/ GFBFTR(2)
      COMMON /GFGEL/ GFGEL(28)
      REAL X
      REAL C
      REAL S
      DX = XP - XC
      DY = YP - YC
      D2 = DX*DX + DY*DY
      IOK = 0
      IF (D2 .LE. R*R) RETURN
      L = (D2 - R*R)/D2
      T = R*R/D2
      U = R*(L**0.5)/D2
      X1 = XC + T*DX - U*DY
      Y1 = YC + T*DY + U*DX
      X2 = XC + T*DX + U*DY
      Y2 = YC + T*DY - U*DX
      IOK = 1
      RETURN
      ENTRY SQRT(Q0)
      IF (Q0 .GT. 0.0) Q0 = Q0**0.5
      RETURN
      ENTRY ATAN(Q1, Q2)
      Q2 = ATAN2(Q1, 1.0)
      RETURN
      ENTRY ABS(Q3)
      IF (Q3 .LT. 0.0) Q3 = -Q3
      RETURN
      ENTRY SIN(Q4, Q5)
      CALL LTCTG(Q4, Q5, C)
      RETURN
      ENTRY COS(Q6, Q7)
      CALL LTCTG(Q6, S, Q7)
      RETURN
      END
      SUBROUTINE LTCTG(A, S, C)
      REAL A, S, C
      S = SIN(A)
      C = COS(A)
      RETURN
      END
