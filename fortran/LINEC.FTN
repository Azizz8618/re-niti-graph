C     LINEC - draw a clipped straight line.  Reads two integers and
C     four reals from the buffer, transforms, clips and emits via MOVE.
      SUBROUTINE LINEC(N1, N2)
      INTEGER N1, N2, K1, K2, I, NT
      REAL X0, Y0, X1, Y1, SX, SY, XA, YA, XB, YB
      EXTERNAL IRDB, RDB, TMF, MOVE
      CALL IRDB(2, K1)
      CALL IRDB(3, K2)
      CALL RDB(7, X0)
      CALL RDB(8, Y0)
      CALL RDB(9, X1)
      CALL RDB(10, Y1)
      X1 = X0 + X1
      Y1 = Y0 + Y1
      CALL TMF(SX, SY)
      X0 = X0 * SX
      Y0 = Y0 * SY
      X1 = X1 * SX
      Y1 = Y1 * SY
      N1 = K1
      N2 = K2
      NT = IABS(K1)
      DO 10 I = 1, NT
         XA = AMAX1(AMIN1(X0, X1), AMIN1(X0, X1))
         YA = AMAX1(AMIN1(Y0, Y1), AMIN1(Y0, Y1))
         XB = AMAX1(X0, X1)
         YB = AMAX1(Y0, Y1)
         CALL MOVE(XA, YA)
         CALL MOVE(XB, YB)
         X0 = X0 + SX
   10 CONTINUE
      RETURN
      END
