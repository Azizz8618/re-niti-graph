C     SYMTAB - symbol/glyph lookup in a 725-word constant table
C     (MADLEN SYMTAB).  FOREX INTEGER constants stop at 2**40-1,
C     so the high 8 bits of the packed 48-bit words are dropped.
      SUBROUTINE SYMTAB(IDX, W)
      INTEGER IDX, W, ITAB(467), NTAB
      COMMON /SYMTAB/ ITAB, NTAB
      CALL SYMTB1()
      CALL SYMTB2()
      IF (IDX .LT. 1 .OR. IDX .GT. NTAB) THEN
         W = 0
         RETURN
      END IF
      W = ITAB(IDX)
      RETURN
      END
