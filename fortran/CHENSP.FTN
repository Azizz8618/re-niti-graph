C     CHENSP - generate a cosine-spaced point sequence.
C     The internal loop forms i*(i+step) terms and COS of the phase.
      SUBROUTINE CHENSP(X, Y, N, STEP)
      REAL X, Y, S, T, F, C
      INTEGER N, STEP, I, K
      REAL PI2
      DATA PI2 /6.283185307179586/
      S = 0.0
      T = 0.0
      K = 1
      DO 10 I = 1, N
         F = (S + T + 5.0) * STEP
         C = COS(F * PI2 / 360.0)
         S = S + C
         T = T + C*C
         X = X + S
         Y = Y + T
         K = K + 1
   10 CONTINUE
C [I] The LOG constant 4114441766517106 in CHENSP.mad:263 sets the
C     initial phase; exact recurrence of the source is not recoverable.
      RETURN
      END
