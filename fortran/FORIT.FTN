C     FORIT - iterative refinement (FORIF companion).
      SUBROUTINE FORIT(A, N, X, Y)
      REAL Q0
      REAL Q1
      REAL Q2
      REAL Q3
      INTEGER Q4
      INTEGER Q5
      INTEGER Q6
      REAL A, X(1000), Y(1000)
      INTEGER N
      REAL T, S, C, P, Q, D
      INTEGER I
      REAL U, R
      INTEGER J, K
      T = A
      D = 1.0
      DO 20 I = 1, N
         CALL FRITG(T, S, C)
         P = C*X(I) - S*Y(I)
         Q = S*X(I) + C*Y(I)
         X(I) = P
         Y(I) = Q
         T = T + D*A/FLOAT(N)
   20 CONTINUE
      RETURN
      ENTRY COS(Q0, Q1)
      CALL FRITG(Q0, S, Q1)
      RETURN
      ENTRY SIN(Q2, Q3)
      CALL FRITG(Q2, Q3, C)
      RETURN
      ENTRY IMUI(Q4, Q5, Q6)
      Q6 = Q4*Q5
      RETURN
      END
      SUBROUTINE FRITG(A, S, C)
      REAL A, S, C
      S = SIN(A)
      C = COS(A)
      RETURN
      END
